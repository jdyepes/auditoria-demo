@page "{id:int}"
@model EditAuditsModel

<h2>Editar Auditoría</h2>

<!-- Mensaje general de éxito -->
@if (TempData.Peek("SuccessMessage") != null)
{
    <div class="alert alert-success">@TempData.Peek("SuccessMessage")</div>
}

<!-- Mensaje general de error -->
@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<!-- Resumen de validaciones -->
@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger"></div>
}


<form method="post" asp-antiforgery="true" class="row g-3">
    <input type="hidden" asp-for="Input.Id" />

    <div class="col-md-6">
        <label class="form-label">Título</label>
        <input asp-for="Input.Title" class="form-control" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label class="form-label">Área Auditada</label>
        <input asp-for="Input.AuditedArea" class="form-control" />
        <span asp-validation-for="Input.AuditedArea" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label class="form-label">Fecha de inicio</label>
        <input asp-for="Input.StartDate" type="date" class="form-control" />
        <span asp-validation-for="Input.StartDate" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label class="form-label">Fecha de fin</label>
        <input asp-for="Input.EndDate" type="date" class="form-control" />
        <span asp-validation-for="Input.EndDate" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label class="form-label">Responsable</label>
        <select asp-for="Input.OwnerId"
                asp-items="@(new SelectList(Model.OwnerList, "Id", "Name"))"
                class="form-select">
        </select>
        <span asp-validation-for="Input.OwnerId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label class="form-label">Estado</label>
        <select asp-for="Input.Status" class="form-select" disabled="disabled">
            <option value="0">Pendiente</option>
            <option value="1">En Proceso</option>
            <option value="2">Finalizada</option>
        </select>
        <span asp-validation-for="Input.Status" class="text-danger"></span>
    </div>

    <div class="col-12 d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary" disabled="@(!Model.IsEditable)">Actualizar</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Volver al inicio</a>

        @if ((Auditing.Domain.Enums.AuditStatus)Model.Input.Status < Auditing.Domain.Enums.AuditStatus.Completed)
        {
            <button type="submit"
                    formaction="@Url.Page(null, new { id = Model.Input.Id, handler = "ChangeStatus" })"
                    class="btn btn-outline-primary d-flex align-items-center gap-2">
                <span>Avanzar Estado</span>
                <i class="bi bi-arrow-right-circle-fill fs-5"></i>
            </button>
        }
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}