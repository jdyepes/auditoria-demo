@page "{auditId:int?}"
@model FindingsIndexModel
@{
    ViewData["Title"] = "Hallazgos";
}
<h2>Hallazgos</h2>

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="number" name="auditId" value="@Model.AuditId" class="form-control" placeholder="Audit ID" />
        <select name="severity" class="form-select">
            <option value="">-- Severidad --</option>
            <option value="0">Bajo</option>
            <option value="1">Medio</option>
            <option value="2">Alto</option>
        </select>
        <button type="submit" class="btn btn-primary">Filtrar</button>
    </div>
</form>

<table class="table table-hover table-striped">
    <thead>
        <tr>
            <th>Descripción</th>
            <th>Tipo</th>
            <th>Severidad</th>
            <th>Fecha detección</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var f in Model.Items)
        {
            <tr>
                <td>@f.Description</td>
                <td>@f.Type</td>
                <td>
                    @if (f.Severity == 0)
                    {
                        <span class="badge bg-success">Bajo</span>
                    }
                    else if (f.Severity == 1)
                    {

                        <span class="badge bg-warning">Medio</span>
                    }
                    else
                    {

                        <span class="badge bg-danger">Alto</span>
                    }
                </td>
                <td>@f.DetectionDate.ToShortDateString()</td>
            </tr>
        }
    </tbody>
</table>