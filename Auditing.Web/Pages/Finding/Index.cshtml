@page
@using Auditing.Domain.Enums
@model FindingsIndexModel
@{
    ViewData["Title"] = "Hallazgos";
}

<h2>Hallazgos</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="get" class="mb-3">
    <div class="input-group">
        <!-- Dropdown dinámico de auditorías -->
        <select name="auditId" class="form-select">
            <option value="">-- Seleccione Auditoría --</option>
            @{
                foreach (var audit in Model.Audits)
                {
                    var selected = audit.Id == Model.AuditId ? "selected=\"selected\"" : "";
                    @Html.Raw($"<option value=\"{audit.Id}\" {selected}>{audit.Title} ({audit.Id})</option>")
                }
            }
        </select>

        <!-- Filtro de severidad -->
        <select name="severity" class="form-select">
            <option value="">-- Severidad --</option>
            @{
                var severity = Model.Severity;
                var severities = new[] { "Bajo", "Medio", "Alto" };
                for (int i = 0; i < severities.Length; i++)
                {
                    var selected = severity == i ? "selected=\"selected\"" : "";
                    @Html.Raw($"<option value=\"{i}\" {selected}>{severities[i]}</option>")
                }
            }
        </select>

        <button type="submit" class="btn btn-primary">Filtrar</button>
    </div>
</form>

<table class="table table-hover table-striped">
    <thead>
        <tr>
            <th>Descripción</th>
            <th>Tipo</th>
            <th>Severidad</th>
            <th>Fecha detección</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var f in Model.Items)
        {
            <tr>
                <td>@f.Description</td>
                <td>@f.Type</td>
                <td>
                    @if (f.Severity == 0)
                    {
                        <span class="badge bg-success">Bajo</span>
                    }
                    else if (f.Severity == SeverityLevel.Medium)
                    {
                        <span class="badge bg-warning">Medio</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Alto</span>
                    }
                </td>
                <td>@f.DetectionDate.ToShortDateString()</td>
            </tr>
        }
    </tbody>
</table>

<a asp-page="Create" asp-route-auditId="@Model.AuditId" class="btn btn-success">Agregar Hallazgo</a>

<div class="mt-4 text-center">
    <a asp-page="/Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left-circle me-1"></i> Volver al inicio
    </a>
</div>