@page "{auditId:int?}"
@model FindingsIndexModel
@{
    ViewData["Title"] = "Hallazgos";
}

<h2>Hallazgos</h2>

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="number" name="auditId" value="@Model.AuditId" class="form-control" placeholder="Audit ID" />
        <select name="severity" class="form-select">
            <option value="">-- Severidad --</option>
            <option value="0">Bajo</option>
            <option value="1">Medio</option>
            <option value="2">Alto</option>
        </select>
        <button type="submit" class="btn btn-primary">Filtrar</button>
    </div>
</form>

<table class="table table-hover table-striped">
    <thead>
        <tr>
            <th>Descripción</th>
            <th>Tipo</th>
            <th>Severidad</th>
            <th>Fecha detección</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var f in Model.Items)
        {
            <tr>
                <td>@f.Description</td>
                <td>@f.Type</td>
                <td>
                    @if (f.Severity == 0)
                    {
                        <span class="badge bg-success">Bajo</span>
                    }
                    else if (f.Severity == 1)
                    {

                        <span class="badge bg-warning">Medio</span>
                    }
                    else
                    {

                        <span class="badge bg-danger">Alto</span>
                    }
                </td>
                <td>@f.DetectionDate.ToShortDateString()</td>
            </tr>
        }
    </tbody>
</table>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Descripción</th>
            <th>Tipo</th>
            <th>Severidad</th>
            <th>Fecha</th>
            <th>Cerrado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var f in Model.Items)
        {
            <tr>
                <td>@f.Description</td>
                <td>@f.Type</td>
                <td>@(f.Severity == 0 ? "Bajo" : f.Severity == 1 ? "Medio" : "Alto")</td>
                <td>@f.DetectionDate.ToShortDateString()</td>
                <td>@(f.IsClosed ? "Sí" : "No")</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@f.Id" class="btn btn-sm btn-primary">Editar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-page="Create" asp-route-auditId="@Model.Items.FirstOrDefault()?.AuditId" class="btn btn-success">Agregar Hallazgo</a>


<div class="mt-4 text-center">
    <a asp-page="/Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left-circle me-1"></i> Volver al inicio
    </a>
</div>